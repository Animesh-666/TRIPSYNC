# ===============================================================
# TRAVEL BOOKING DATA ORGANIZER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# ===============================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Server-Side Firebase Admin SDK Credentials
# Option 1: Absolute or relative path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Option 2: Raw JSON string of the service account key (useful on Render/cloud hosting)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'

# Client-Side Firebase Web Configuration (Public)
# Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=AIzaSyYourApiKeyHere
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456
